import os
import requests
import yfinance as yf

# Pulls credentials securely from GitHub Secrets
TELEGRAM_TOKEN = os.getenv("TELEGRAM_TOKEN")
CHAT_ID = os.getenv("CHAT_ID")

# Markets to monitor (Yahoo Finance Tickers for Forex, Gold, Crypto)
SYMBOLS = {
    "EURUSD": "EURUSD=X",
    "GBPUSD": "GBPUSD=X",
    "GOLD": "GC=F",
    "BITCOIN": "BTC-USD"
}

def send_telegram_alert(message):
    url = f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/sendMessage"
    payload = {"chat_id": CHAT_ID, "text": message, "parse_mode": "Markdown"}
    requests.post(url, json=payload)

def analyze_market():
    for name, ticker in SYMBOLS.items():
        data = yf.download(ticker, period="5d", interval="15m", progress=False)
        if data.empty:
            continue

        # Indicator setup: 9 EMA & 21 EMA crossover
        close = data['Close'].iloc[:, 0] if hasattr(data['Close'], 'iloc') else data['Close']
        ema_fast = close.ewm(span=9, adjust=False).mean()
        ema_slow = close.ewm(span=21, adjust=False).mean()
        
        latest_price = round(close.iloc[-1], 4)
        
        # Bullish Crossover (BUY)
        if ema_fast.iloc[-2] <= ema_slow.iloc[-2] and ema_fast.iloc[-1] > ema_slow.iloc[-1]:
            msg = f"🚀 *EXNESS BUY SIGNAL*\n\nAsset: *{name}*\nPrice: `{latest_price}`\nTimeframe: 15m\nStrategy: EMA Crossover"
            send_telegram_alert(msg)
            
        # Bearish Crossover (SELL)
        elif ema_fast.iloc[-2] >= ema_slow.iloc[-2] and ema_fast.iloc[-1] < ema_slow.iloc[-1]:
            msg = f"🔻 *EXNESS SELL SIGNAL*\n\nAsset: *{name}*\nPrice: `{latest_price}`\nTimeframe: 15m\nStrategy: EMA Crossover"
            send_telegram_alert(msg)

if __name__ == "__main__":
    analyze_market()
